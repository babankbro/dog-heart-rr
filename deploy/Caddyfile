# ถ้า SITE_ADDRESS เป็นชื่อโดเมน caddy จะขอใบรับรอง HTTPS ให้เองอัตโนมัติ
# ถ้าเป็น :80 จะเสิร์ฟ HTTP ล้วน (ใช้ได้เมื่อมีแค่ IP ยังไม่มีโดเมน)
{$SITE_ADDRESS} {
	# ข้อมูลในเว็บนี้เป็นภาพผู้ป่วย ตัวแอปไม่มีระบบล็อกอินของตัวเอง
	# ด่านนี้จึงเป็นสิ่งเดียวที่กั้นอยู่ — ถ้าจะเอาออกให้รู้ตัวว่าเปิดสาธารณะจริง ๆ
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	reverse_proxy web:8000

	# เผื่อให้อัปโหลดภาพสแกนความละเอียดสูงได้
	request_body {
		max_size 64MB
	}

	encode gzip
	log {
		output file /data/access.log
	}
}
