# ถ้า SITE_ADDRESS เป็นชื่อโดเมน caddy จะขอใบรับรอง HTTPS ให้เองอัตโนมัติ
# ถ้าเป็น :80 จะเสิร์ฟ HTTP ล้วน (ใช้ได้เมื่อมีแค่ IP ยังไม่มีโดเมน)
{$SITE_ADDRESS} {
	# ด่านรหัสผ่านอยู่ในไฟล์แยก เพราะ Caddyfile ไม่มี if
	# มีไฟล์ใน deploy/auth/ = ต้องล็อกอิน, ไม่มีไฟล์ = เปิดสาธารณะ
	# bootstrap.sh เป็นคนสร้างหรือลบไฟล์นั้นให้ตามที่สั่ง
	import /etc/caddy/auth/*.caddy

	reverse_proxy web:8000

	# เผื่อให้อัปโหลดภาพสแกนความละเอียดสูงได้
	request_body {
		max_size 64MB
	}

	encode gzip
	log {
		output file /data/access.log
	}
}
